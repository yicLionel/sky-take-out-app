.profile-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #fff;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  background: #edf0f2;
}

.nickname {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.cell {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #1f2a33;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: left;
}

.danger {
  color: #c4382b;
}
