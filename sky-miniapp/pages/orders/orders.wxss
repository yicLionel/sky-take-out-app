.order-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.order-head,
.dish-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  font-size: 28rpx;
  font-weight: 700;
}

.status {
  color: #1f8a70;
  font-size: 24rpx;
}

.dish-line {
  padding-top: 18rpx;
  color: #34414a;
  font-size: 26rpx;
}

.order-total {
  margin-top: 18rpx;
  text-align: right;
  color: #d24734;
  font-size: 30rpx;
  font-weight: 700;
}
