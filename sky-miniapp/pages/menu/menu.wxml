<view class="menu-page">
  <view class="shop-row">
    <view>
      <view class="shop-title">苍穹餐厅</view>
      <view class="shop-status">{{shopOpen ? '营业中' : '休息中'}}</view>
    </view>
    <view class="cart-pill" bindtap="goCart">购物车 {{cartCount}}</view>
  </view>

  <view class="content">
    <scroll-view scroll-y class="categories">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category {{activeCategoryId === item.id ? 'active' : ''}}"
        bindtap="selectCategory"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view scroll-y class="products">
      <view wx:if="{{items.length === 0}}" class="empty">当前分类暂无商品</view>
      <view wx:for="{{items}}" wx:key="id" class="product">
        <image class="product-image" src="{{item.fullImage}}" mode="aspectFill"></image>
        <view class="product-main">
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.description}}</view>
          <view class="flavor" wx:if="{{item.flavorText}}">{{item.flavorText}}</view>
          <view class="product-footer">
            <view class="price">¥{{item.price}}</view>
            <button class="add-btn" bindtap="addItem" data-id="{{item.id}}">+</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
