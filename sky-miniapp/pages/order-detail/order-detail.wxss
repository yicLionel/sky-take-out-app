.detail-head,
.section {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.detail-title {
  margin-bottom: 10rpx;
  color: #1f8a70;
  font-size: 40rpx;
  font-weight: 700;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.line {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 27rpx;
}

.address {
  margin-top: 10rpx;
  color: #1f2a33;
  font-size: 28rpx;
  line-height: 1.45;
}
