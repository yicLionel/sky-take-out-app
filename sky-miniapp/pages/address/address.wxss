.form,
.address-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.form-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  height: 72rpx;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #f6f7f8;
  font-size: 28rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #edf7f3;
  color: #1f8a70;
  font-size: 22rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.small-btn {
  flex: 1;
  height: 64rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #eef1f2;
  color: #1f2a33;
  font-size: 24rpx;
  line-height: 64rpx;
}

.danger {
  color: #c4382b;
}
