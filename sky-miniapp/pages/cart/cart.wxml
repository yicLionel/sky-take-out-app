<view class="page cart-page">
  <view wx:if="{{items.length === 0}}" class="empty">购物车还是空的</view>
  <view wx:for="{{items}}" wx:key="id" class="cart-item">
    <image class="cart-image" src="{{item.fullImage}}" mode="aspectFill"></image>
    <view class="cart-main">
      <view class="cart-name">{{item.name}}</view>
      <view class="muted">{{item.dishFlavor || '标准'}}</view>
      <view class="cart-footer">
        <view class="price">¥{{item.amount}}</view>
        <view class="stepper">
          <button class="step-btn" bindtap="subItem" data-index="{{index}}">-</button>
          <view class="num">{{item.number}}</view>
          <button class="step-btn" bindtap="addItem" data-index="{{index}}">+</button>
        </view>
      </view>
    </view>
  </view>

  <view class="cart-bar" wx:if="{{items.length > 0}}">
    <view>
      <view class="muted">合计</view>
      <view class="total">¥{{total}}</view>
    </view>
    <button class="primary-btn checkout-btn" bindtap="goCheckout">去结算</button>
  </view>
</view>
