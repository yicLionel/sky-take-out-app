page {
  background: #f6f7f8;
  color: #1f2a33;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.primary-btn {
  height: 88rpx;
  border-radius: 8rpx;
  background: #1f8a70;
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.ghost-btn {
  height: 72rpx;
  border-radius: 8rpx;
  border: 1rpx solid #cfd7dc;
  color: #1f2a33;
  background: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.muted {
  color: #7c858c;
  font-size: 24rpx;
}

.price {
  color: #d24734;
  font-weight: 700;
}

.empty {
  padding: 96rpx 24rpx;
  text-align: center;
  color: #7c858c;
  font-size: 28rpx;
}
